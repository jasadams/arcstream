{
  "tableName": "sessions",
  "tableType": "REALTIME",
  "segmentsConfig": {
    "timeColumnName": "start_time",
    "timeType": "MILLISECONDS",
    "retentionTimeUnit": "DAYS",
    "retentionTimeValue": "90",
    "replication": "1",
    "completionConfig": {
      "completionMode": "DOWNLOAD"
    }
  },
  "tableIndexConfig": {
    "invertedIndexColumns": ["tenant_id", "canonical_id", "device_type", "country"],
    "rangeIndexColumns": ["start_time", "end_time", "duration_sec", "event_count"],
    "sortedColumn": ["start_time"],
    "starTreeIndexConfigs": [{
      "dimensionsSplitOrder": ["tenant_id", "session_date", "session_hour", "country", "device_type", "browser"],
      "skipStarNodeCreationForDimensions": [],
      "functionColumnPairs": [
        "COUNT__*",
        "SUM__duration_sec",
        "AVG__duration_sec",
        "DISTINCTCOUNTHLL__canonical_id",
        "DISTINCTCOUNTHLL__session_id",
        "SUM__event_count"
      ],
      "maxLeafRecords": 10000
    }]
  },
  "fieldConfigList": [
    {"name": "session_id", "encodingType": "RAW", "compressionCodec": "ZSTANDARD"},
    {"name": "canonical_id", "encodingType": "RAW", "compressionCodec": "ZSTANDARD"}
  ],
  "ingestionConfig": {
    "transformConfigs": [
      {
        "columnName": "session_date",
        "transformFunction": "substr(start_time, 0, 10)"
      },
      {
        "columnName": "session_hour",
        "transformFunction": "substr(start_time, 0, 13)"
      }
    ],
    "streamIngestionConfig": {
      "streamConfigMaps": [{
        "streamType": "kafka",
        "stream.kafka.topic.name": "session-events",
        "stream.kafka.broker.list": "redpanda.data-pipeline.svc.cluster.local:9092",
        "stream.kafka.consumer.type": "lowLevel",
        "stream.kafka.decoder.class.name": "org.apache.pinot.plugin.stream.kafka.KafkaJSONMessageDecoder",
        "stream.kafka.consumer.factory.class.name": "org.apache.pinot.plugin.stream.kafka20.KafkaConsumerFactory",
        "stream.kafka.consumer.prop.auto.offset.reset": "smallest",
        "realtime.segment.flush.threshold.rows": "500000",
        "realtime.segment.flush.threshold.time": "6h"
      }]
    }
  },
  "tenants": {
    "broker": "DefaultTenant",
    "server": "DefaultTenant"
  },
  "metadata": {
    "customConfigs": {}
  }
}
